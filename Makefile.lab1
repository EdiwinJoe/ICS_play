# Lab1: DataLab -- local build rules.
#
# The DataLab Makefile and its support files (tests.c, decl.c, btest.c, ...)
# are not part of this repository, and the bundled dlc/btest are 32-bit Linux
# ELF binaries that do not run on Windows.  This file therefore builds the
# equivalent local test driver used for the Lab1 verification:
#
#     make -f Makefile.lab1          # build the driver
#     make -f Makefile.lab1 test     # run it (expects Total points: 110/110)
#     make -f Makefile.lab1 ops      # operator-count check
#     make -f Makefile.lab1 clean
#
# On a Linux machine with the real DataLab files, use `make clean && make all`
# and then `./check_ops.py bits.c` / `./btest` instead.

CC = gcc
CFLAGS ?= -O2 -std=c99 -Wall
PYTHON ?= python3
RM ?= rm -f

DRIVER = tools/lab1_labtest

.PHONY: all test ops clean

all: $(DRIVER)

$(DRIVER): tools/lab1_labtest.c bits.c bits.h
	$(CC) $(CFLAGS) -I. -o $@ tools/lab1_labtest.c bits.c -lm

test: $(DRIVER)
	./$(DRIVER)

ops:
	$(PYTHON) tools/lab1_opcount.py bits.c

clean:
	-$(RM) $(DRIVER) $(DRIVER).exe
